\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Index replacement and temporally grouped masks. \textbf  {a}, Consecutive erased positions use their preceding original indices, whereas substitution draws legal index values. Highlighted cells identify selected positions. \textbf  {b}, An illustrative selected five-frame group spans 100~ms. \textbf  {c}, An illustrative ten-frame burst spans 200~ms. The grouped masks in b and c cover the same temporal positions in all three RVQ layers. Frame zero is protected by the erasure-replacement operator. The diagrams specify the evaluation protocol; they do not depict measured packet traces.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:sv3-perturbations}{{S3}{10}{Index replacement and temporally grouped masks. \textbf {a}, Consecutive erased positions use their preceding original indices, whereas substitution draws legal index values. Highlighted cells identify selected positions. \textbf {b}, An illustrative selected five-frame group spans 100~ms. \textbf {c}, An illustrative ten-frame burst spans 200~ms. The grouped masks in b and c cover the same temporal positions in all three RVQ layers. Frame zero is protected by the erasure-replacement operator. The diagrams specify the evaluation protocol; they do not depict measured packet traces}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Utterance-level SCIT-LCA minus SCIT differences on the same 2,620 LibriSpeech test-clean utterances per condition at $L=3$. The five conditions comprise clean transmission, 10\% independent erasure, 3\% independent substitution, 5\% five-frame packet masking and one 200-ms burst. Each model pair is matched by utterance and channel seed. Diamonds show means over all 2,620 differences; boxes show interquartile ranges with 5th--95th-percentile whiskers, while violin densities display only the central 98\% to limit the influence of extreme tails on the plotting range. The dashed line indicates zero; lower mel-L1 and higher STOI/PESQ-WB are favourable. No significance test is implied.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:sv4-paired-robustness}{{S4}{10}{Utterance-level SCIT-LCA minus SCIT differences on the same 2,620 LibriSpeech test-clean utterances per condition at $L=3$. The five conditions comprise clean transmission, 10\% independent erasure, 3\% independent substitution, 5\% five-frame packet masking and one 200-ms burst. Each model pair is matched by utterance and channel seed. Diamonds show means over all 2,620 differences; boxes show interquartile ranges with 5th--95th-percentile whiskers, while violin densities display only the central 98\% to limit the influence of extreme tails on the plotting range. The dashed line indicates zero; lower mel-L1 and higher STOI/PESQ-WB are favourable. No significance test is implied}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Waveform and log-power mel-spectrogram comparison for a representative LibriSpeech test-clean utterance at $L=3$. The panels show the source signal, clean SCIT reconstruction, clean SCIT-LCA reconstruction, SCIT reconstruction under 10\% independent index erasure, and SCIT-LCA reconstruction under the same erasure condition. Every panel uses the same three-second maximum-energy interval determined from the source waveform. Waveforms share an amplitude range and spectrograms share a colour scale. This example is qualitative; corpus-level interpretation follows the aggregate metrics and paired distributions.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:sv5-reconstruction-example}{{S5}{11}{Waveform and log-power mel-spectrogram comparison for a representative LibriSpeech test-clean utterance at $L=3$. The panels show the source signal, clean SCIT reconstruction, clean SCIT-LCA reconstruction, SCIT reconstruction under 10\% independent index erasure, and SCIT-LCA reconstruction under the same erasure condition. Every panel uses the same three-second maximum-energy interval determined from the source waveform. Waveforms share an amplitude range and spectrograms share a colour scale. This example is qualitative; corpus-level interpretation follows the aggregate metrics and paired distributions}{figure.5}{}}
