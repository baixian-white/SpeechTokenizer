\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Logical architecture and operating conditions of the six-user real-time communication experiment. \textbf  {a}, Six enrolled endpoints exchange 0.5-s blocks through a common coordination layer, giving 30 directed source--receiver relations when self-directed streams are excluded. Each block retains source, destination, stream and sequence metadata. \textbf  {b}, Receiver-side stream identification and ordered reassembly recover the three-layer RVQ indices. The indices feed local codebook lookup and waveform reconstruction while also being retained in a token buffer; the paired waveform and token context supports speaker identification. Recognition accuracy and P95 identification RTF describe identity inference, whereas STOI and PESQ-WB describe reconstructed speech. \textbf  {c}, Sequential, simultaneous and 30-min continuous simultaneous input conditions. The icons specify logical data roles and do not prescribe a physical deployment.}}{19}{figure.9}\protected@file@percent }
\newlabel{fig:sv3-six-user-architecture}{{S9}{19}{Logical architecture and operating conditions of the six-user real-time communication experiment. \textbf {a}, Six enrolled endpoints exchange 0.5-s blocks through a common coordination layer, giving 30 directed source--receiver relations when self-directed streams are excluded. Each block retains source, destination, stream and sequence metadata. \textbf {b}, Receiver-side stream identification and ordered reassembly recover the three-layer RVQ indices. The indices feed local codebook lookup and waveform reconstruction while also being retained in a token buffer; the paired waveform and token context supports speaker identification. Recognition accuracy and P95 identification RTF describe identity inference, whereas STOI and PESQ-WB describe reconstructed speech. \textbf {c}, Sequential, simultaneous and 30-min continuous simultaneous input conditions. The icons specify logical data roles and do not prescribe a physical deployment}{figure.9}{}}
\newlabel{eq:sv3-six-user-rtf}{{S48}{19}{Speaker-identification scoring and inference RTF}{equation.48}{}}
