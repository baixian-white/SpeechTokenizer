            <mxPoint x="1370" y="1180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x_mark" value="✕" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1160" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="no_wave_label" value="No waveform, no continuous features" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1210" width="340" height="30" as="geometry" />
        </mxCell>

        <!-- ============= RECEIVER PANEL ============= -->
        <mxCell id="receiver_box" value="Receiver" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 4;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=22;fontStyle=1;verticalAlign=top;align=center;spacingTop=10;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="1420" y="500" width="840" height="940" as="geometry" />
        </mxCell>

        <!-- Received indices container -->
        <mxCell id="recv_idx_box" value="Received indices" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1450" y="600" width="220" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ridx1" value="i&lt;sup&gt;(1)&lt;/sup&gt; &lt;span style='background:#7CB7E0;padding:0 6px;border:1px solid #4F8EBC;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style='background:#7CB7E0;padding:0 6px;border:1px solid #4F8EBC;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style='background:#7CB7E0;padding:0 6px;border:1px solid #4F8EBC;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;..." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1465" y="660" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ridx2" value="i&lt;sup&gt;(2)&lt;/sup&gt; &lt;span style='background:#F0DC8A;padding:0 6px;border:1px solid #B89A4A;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style='background:#F0DC8A;padding:0 6px;border:1px solid #B89A4A;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style='background:#F0DC8A;padding:0 6px;border:1px solid #B89A4A;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;..." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1465" y="780" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ridx3" value="i&lt;sup&gt;(3)&lt;/sup&gt; &lt;span style='background:#F0A5A1;padding:0 6px;border:1px solid #C97874;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style='background:#F0A5A1;padding:0 6px;border:1px solid #C97874;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style='background:#F0A5A1;padding:0 6px;border:1px solid #C97874;'&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;..." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1465" y="900" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="recv_note" value="i&lt;sup&gt;(2)&lt;/sup&gt; used when L &amp;ge; 2,&#10;i&lt;sup&gt;(3)&lt;/sup&gt; used when L = 3" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1000" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Shared Codebook Lookup -->
        <mxCell id="lookup" value="Shared Codebook&#10;Lookup&#10;&#10;🔍" style="rounded=1;arcSize=8;fillColor=#F0E9FE;strokeColor=#7B61FF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1700" y="730" width="150" height="120" as="geometry" />
        </mxCell>

        <!-- Recovered z_hat cube -->
        <mxCell id="zhat" value="Recovered&#10;z_hat" style="shape=cube;size=20;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;darkOpacity=0.05;" vertex="1" parent="1">
          <mxGeometry x="1880" y="740" width="130" height="110" as="geometry" />
        </mxCell>

        <!-- Decoder D container -->
        <mxCell id="dec_box" value="Decoder D" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="2030" y="580" width="170" height="540" as="geometry" />
        </mxCell>
        <mxCell id="dec1" value="Conv Layer 1&#10;(Upsample x4)" style="rounded=1;arcSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2050" y="620" width="130" height="105" as="geometry" />
        </mxCell>
        <mxCell id="dec2" value="Conv Layer 2&#10;(Upsample x4)" style="rounded=1;arcSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2050" y="735" width="130" height="105" as="geometry" />
        </mxCell>
        <mxCell id="dec3" value="Conv Layer 3&#10;(Upsample x4)" style="rounded=1;arcSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2050" y="850" width="130" height="105" as="geometry" />
        </mxCell>
        <mxCell id="dec4" value="Conv Layer 4&#10;(Upsample x5)" style="rounded=1;arcSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2050" y="965" width="130" height="105" as="geometry" />
        </mxCell>

        <!-- Receiver flow arrows -->
        <mxCell id="er_idx_lookup" style="endArrow=classic;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="recv_idx_box" target="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er_lookup_zhat" style="endArrow=classic;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lookup" target="zhat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er_zhat_dec" style="endArrow=classic;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="zhat" target="dec_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reconstructed speech container (placed to right of decoder, but limited space - put below decoder) -->
        <mxCell id="recon_box" value="Reconstructed&#10;speech x_hat(t)" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="2030" y="1140" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="wave_out" value="Waveform &lt;span style='font-family:monospace;color:#1565C0;'&gt;⌇⌇⌇⌇&lt;/span&gt; / Time" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2050" y="1180" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mel_out" value="Mel-spectrogram &lt;span style='font-family:monospace;color:#6A1B9A;'&gt;▓▒░▒&lt;/span&gt; / Freq · Time" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2050" y="1280" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="er_dec_recon" style="endArrow=classic;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dec_box" target="recon_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Receiver bottom annotation -->
        <mxCell id="recv_bottom" value="Total upsampling 320x &amp;rarr; 16 kHz waveform" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1820" y="1390" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Cross-panel arrows: Sender indices -> Channel cloud, Channel cloud -> Receiver indices -->
        <mxCell id="cross1" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="idx1" target="perturb_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cross2" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="idx2" target="perturb_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cross3" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="idx3" target="perturb_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cross_out1" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=2;exitX=1;exitY=0.4;entryX=0;entryY=0.2;" edge="1" parent="1" source="cloud" target="recv_idx_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
