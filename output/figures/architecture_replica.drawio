        <mxCell id="e_rvq1_idx1" style="endArrow=classic;strokeColor=#4F8EBC;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rvq1" target="idx1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rvq2_idx2" style="endArrow=classic;strokeColor=#B89A4A;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rvq2" target="idx2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rvq3_idx3" style="endArrow=classic;strokeColor=#C97874;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rvq3" target="idx3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sender bottom annotation -->
        <mxCell id="sender_bottom" value="Total downsampling 320x &amp;rarr; f&lt;sub&gt;q&lt;/sub&gt; = 50 Hz" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="1390" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- ============= LOW-LOAD CHANNEL PANEL ============= -->
        <mxCell id="channel_box" value="Low-Load Channel" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 4;fillColor=#FFF8DD;strokeColor=#F0A800;strokeWidth=2;fontSize=22;fontStyle=1;verticalAlign=top;align=center;spacingTop=10;fontColor=#A77800;" vertex="1" parent="1">
          <mxGeometry x="1000" y="500" width="400" height="940" as="geometry" />
        </mxCell>

        <!-- Channel Perturbations -->
        <mxCell id="perturb_box" value="&lt;b&gt;Channel Perturbations&lt;/b&gt;&lt;ul style='margin:8px 0 0 18px;padding:0;text-align:left;'&gt;&lt;li&gt;dropout&lt;/li&gt;&lt;li&gt;substitution&lt;/li&gt;&lt;li&gt;packet loss&lt;/li&gt;&lt;li&gt;burst loss&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;html=1;fillColor=#FFF4D2;strokeColor=#B89A4A;fontSize=12;align=center;verticalAlign=top;spacingTop=8;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1030" y="600" width="340" height="200" as="geometry" />
        </mxCell>

        <!-- Index-only Transmission arrow -->
        <mxCell id="trans_arrow" value="Index-only Transmission" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=4;fontColor=#1565C0;fontSize=14;fontStyle=1;labelBackgroundColor=#FFF8DD;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="850" as="sourcePoint" />
            <mxPoint x="1380" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Cloud: transmit top-L layers -->
        <mxCell id="cloud" value="Transmit top-L layers,&#10;L in {1, 2, 3},&#10;R(L) = L * 500 bps" style="ellipse;shape=cloud;fillColor=#FFFFFF;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1030" y="900" width="340" height="220" as="geometry" />
        </mxCell>

        <!-- Red dashed X with text -->
        <mxCell id="x_line" style="endArrow=none;dashed=1;dashPattern=8 4;strokeColor=#D32F2F;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
